# Copy to .env for docker compose. Never commit .env.
POSTGRES_PASSWORD=change-me
# At least 32 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Auctioneer access code, at least 8 characters
ADMIN_PIN=
# BID_INCREMENT=100
# BID_SECONDS=30
# PORT=8000
# Loaded on first start only, into an empty database (path inside backend/)
# SEED_FILE=seed.example.json

# Server: listen on port 80 instead of 8000
# PORT=80
# Where the real exports live in S3 (make pull-data), and their file names in data/
# S3_DATA=s3://your-bucket/sportsaxle/
# FORM=form.xlsx
# CAPTAINS=captains.zip
# PLAYERS=players.zip
